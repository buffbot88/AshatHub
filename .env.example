# ═══════════════════════════════════════════════════════════════════════
# ASHAT Hub — environment configuration
# ═══════════════════════════════════════════════════════════════════════
# Copy to .env and fill in real values. .env is gitignored.

# App
APP_NAME="ASHAT Hub"
APP_ENV=development             # development | production
APP_DEBUG=true                  # false in production
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Database (MySQL/MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ashat_hub
DB_USER=root
DB_PASS=

# Session / Security
SESSION_LIFETIME=7200           # seconds (default 2h)
SESSION_COOKIE_NAME=ashat_sid
SESSION_SECURE_COOKIE=false     # true in production (HTTPS only)

# APP_KEY is no longer used for API-key encryption (BYO keys live in
# browser localStorage only). Kept as a reserved general-purpose
# secret for future use (CSRF seed, signed-cookie tweaks, etc.).
APP_KEY=change-me-to-32-random-bytes-base64

# If your host doesn't pick up .env (free shared hosts like ByetHost
# free, VistaPanel-hosted sites, etc. — dotfile uploads blocked by the
# file manager or FTP client), copy config/conn.php.example to
# config/conn.php and edit your real DB credentials there. conn.php
# is a regular PHP file — NOT a dotfile — so it always uploads fine,
# and its putenv() calls OVERRIDE everything in this file.

# Debug-mode token (long random string). When set, you can visit
# `?debug=1&t=THIS_TOKEN` to surface PHP fatals in-browser via a
# register_shutdown_function in the entry-point files. Leave blank to
# disable the lever entirely (recommended for production).
# Generate one with:  openssl rand -hex 32
DEBUG_TOKEN=

# Misc
LOG_ERRORS=true
LOG_PATH=storage/logs
