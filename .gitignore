# ═══════════════════════════════════════════════════════════════════════
# ASHAT OS — .gitignore (vanilla PHP)
# ═══════════════════════════════════════════════════════════════════════

# Secrets
.env
.env.local
.env.*.local

# Production config — carries live credentials, must NEVER be committed.
config/server_config.json

# Logs
storage/logs/*.log

# Runtime
storage/cache/*
!storage/cache/.gitkeep
storage/maintenance.json

# Editor / OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Build artifacts (in case Tailwind CLI is added later)
public/css/build/
public/js/build/

# Temporary dev deps (only needed to recompile public/css/tailwind-prod.css)
node_modules/

# AshatOS_Old archive should NOT be committed
AshatOS_Old/
/.freebuff

# PHPUnit phar (no composer.json in this repo)
phpunit.phar
# PHPUnit cache dir (created on every run)
.phpunit.cache/
models/mmproj-LFM2.5-VL-450m-Q8_0.gguf
models/LFM2.5-VL-450M-Q8_0.gguf
