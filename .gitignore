# ═══════════════════════════════════════════════════════════════════════
# ASHAT OS — .gitignore (vanilla PHP)
# ═══════════════════════════════════════════════════════════════════════

# Secrets
.env
.env.local
.env.*.local

# Free-host config files — ship as .example only (in older versions),
# the real files carry live credentials and must NEVER be committed.
config/conn.php
config/server_config.json

# Logs
storage/logs/*.log

# Runtime
storage/cache/*
!storage/cache/.gitkeep
storage/maintenance.json

# Editor / OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Build artifacts (in case Tailwind CLI is added later)
public/css/build/
public/js/build/

# AshatOS_Old archive should NOT be committed
AshatOS_Old/
/.freebuff
