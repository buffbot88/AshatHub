{
  "// _comment": [
    "═══════════════════════════════════════════════════════════════════",
    " ASHAT Hub — Server Configuration",
    "",
    " If your shared host blocks dotfiles (like .env), use this file",
    " instead. Copy to config/server_config.json and edit your values.",
    " This file runs BEFORE .env and takes priority — if it exists,",
    " .env is skipped entirely.",
    "",
    " Steps:",
    "   1. cp config/server_config.json.example config/server_config.json",
    "   2. Edit each value below (uncomment by removing //).",
    "   3. Upload to your server via FTP/File Manager.",
    "   4. config/conn.php is still supported for DB-only overrides.",
    "═══════════════════════════════════════════════════════════════════"
  ],

  "// ── App Settings ────────────────────────────────────────────────────": "",

  "APP_NAME": "ASHAT Hub",

  "// APP_ENV": "'development' for local, 'production' for live",
  "APP_ENV": "production",

  "// APP_DEBUG": "true shows errors; false hides them in production",
  "APP_DEBUG": "false",

  "// APP_URL": "Must match your domain — used by asset() and webhook URL",
  "APP_URL": "https://yourdomain.com",

  "// APP_TIMEZONE": "PHP timezone (see php.net/manual/en/timezones.php)",
  "APP_TIMEZONE": "UTC",

  "// ── Database ────────────────────────────────────────────────────────": "",

  "DB_HOST": "localhost",
  "DB_PORT": 3306,
  "DB_NAME": "ashat_hub",
  "DB_USER": "root",
  "DB_PASS": "",

  "// ── Session ────────────────────────────────────────────────────────": "",

  "// SESSION_LIFETIME": "Seconds before session expires (default 2 hours)",
  "SESSION_LIFETIME": 7200,

  "// SESSION_COOKIE_NAME": "Cookie name for the session ID",
  "SESSION_COOKIE_NAME": "ashat_sid",

  "// SESSION_SECURE_COOKIE": "true if your site is HTTPS-only",
  "SESSION_SECURE_COOKIE": false,

  "// ── Security ────────────────────────────────────────────────────────": "",

  "// APP_KEY": "32+ byte base64 key for encryption. Generate: openssl rand -base64 32",
  "APP_KEY": "",

  "// DEBUG_TOKEN": "Secret string for ?debug=1&t=TOKEN. Generate: openssl rand -hex 32",
  "DEBUG_TOKEN": "",

  "// ── AI Backend (BrainStem) ──────────────────────────────────────────": "",

  "// BRAINSTEM_URL": "Your BrainStem/HuggingFace Space URL",
  "BRAINSTEM_URL": "http://localhost:7860",

  "// BRAINSTEM_KEY": "API key for the BrainStem backend (if required)",
  "BRAINSTEM_KEY": "",

  "// ── Logging ─────────────────────────────────────────────────────────": "",

  "// LOG_ERRORS": "Write PHP errors to storage/logs/error.log",
  "LOG_ERRORS": "true"
}
