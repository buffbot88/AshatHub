# ═══════════════════════════════════════════════════════════════════════
# ASHAT OS — Apache rewrite rules
# Funnels every request that isn't a real file/directory through index.php
# ═══════════════════════════════════════════════════════════════════════

<IfModule mod_rewrite.c>
  RewriteEngine On

  # If the request matches an existing file or directory, serve it.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise route to the front controller
  RewriteRule ^ index.php [L,QSA]
</IfModule>

# Disable directory listing
Options -Indexes

# Cache static assets
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|gif|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Friendly PHP errors in development (turn off in prod)
<IfModule mod_php.c>
  php_flag display_errors on
  php_value error_reporting E_ALL
</IfModule>
