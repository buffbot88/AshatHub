<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" fill="none">
  <defs>
    <linearGradient id="bg128" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#11111a"/>
      <stop offset="100%" stop-color="#06060b"/>
    </linearGradient>
    <linearGradient id="gold" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#f4c55d"/>
      <stop offset="100%" stop-color="#c9a23e"/>
    </linearGradient>
  </defs>
  <rect width="128" height="128" rx="20" fill="url(#bg128)" stroke="#1c1c2a" stroke-width="1"/>
  <!-- Outer mane -->
  <path d="M64 20L32 38v28c0 18 13.6 34 32 38 18.4-4 32-20 32-38V38L64 20z" fill="url(#gold)" opacity="0.10"/>
  <!-- Inner face -->
  <path d="M64 28L40 42v24c0 14 10 26 24 30 14-4 24-16 24-30V42L64 28z" fill="url(#gold)" opacity="0.20"/>
  <!-- Core face -->
  <path d="M64 34L46 45v19c0 10 7.2 18 18 21 10.8-3 18-11 18-21V45L64 34z" fill="url(#gold)" opacity="0.30"/>
  <!-- Eyes -->
  <ellipse cx="48" cy="60" rx="5" ry="6" fill="url(#gold)"/>
  <ellipse cx="80" cy="60" rx="5" ry="6" fill="url(#gold)"/>
  <!-- Pupils -->
  <circle cx="49" cy="61" r="2.5" fill="#06060b"/>
  <circle cx="81" cy="61" r="2.5" fill="#06060b"/>
  <!-- Nose bridge -->
  <path d="M62 72h4l-2 4z" fill="url(#gold)"/>
  <path d="M58 76q6 5 12 0" stroke="url(#gold)" stroke-width="2" fill="none" stroke-linecap="round"/>
  <!-- Ears left -->
  <path d="M32 34l6-10v10z" fill="url(#gold)" opacity="0.4"/>
  <path d="M28 40l-4-6v6z" fill="url(#gold)" opacity="0.25"/>
  <!-- Ears right -->
  <path d="M96 34l-6-10v10z" fill="url(#gold)" opacity="0.4"/>
  <path d="M100 40l4-6v6z" fill="url(#gold)" opacity="0.25"/>
  <!-- Mane spikes L -->
  <path d="M18 56l6-4v6z" fill="url(#gold)" opacity="0.15"/>
  <path d="M14 70l6-3v5z" fill="url(#gold)" opacity="0.15"/>
  <path d="M20 82l6-5v5z" fill="url(#gold)" opacity="0.12"/>
  <!-- Mane spikes R -->
  <path d="M110 56l-6-4v6z" fill="url(#gold)" opacity="0.15"/>
  <path d="M114 70l-6-3v5z" fill="url(#gold)" opacity="0.15"/>
  <path d="M108 82l-6-5v5z" fill="url(#gold)" opacity="0.12"/>
  <!-- Whisker dots -->
  <circle cx="42" cy="72" r="1" fill="#f4c55d" opacity="0.5"/>
  <circle cx="86" cy="72" r="1" fill="#f4c55d" opacity="0.5"/>
</svg>
