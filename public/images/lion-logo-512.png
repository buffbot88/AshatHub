<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="none">
  <defs>
    <linearGradient id="bg512" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#11111a"/>
      <stop offset="100%" stop-color="#06060b"/>
    </linearGradient>
    <linearGradient id="gold512" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#f4c55d"/>
      <stop offset="100%" stop-color="#c9a23e"/>
