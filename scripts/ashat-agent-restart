#!/usr/bin/env bash
set -euo pipefail

server="${1:-}"
case "$server" in
  omega) host="129.213.94.124" ;;
  beta)  host="150.136.208.93" ;;
  delta) host="129.213.147.225" ;;
  *)
    echo "invalid server" >&2
    exit 64
    ;;
esac

key="/root/.ssh/ashat_agent_id_rsa"
known_hosts="/etc/ashat-ai/known_hosts"

if [[ ! -r "$key" || ! -r "$known_hosts" ]]; then
  echo "restart transport is not configured" >&2
  exit 69
fi

exec /usr/bin/ssh \
  -i "$key" \
  -o BatchMode=yes \
  -o StrictHostKeyChecking=yes \
  -o UserKnownHostsFile="$known_hosts" \
  -o ConnectTimeout=8 \
  -o ServerAliveInterval=3 \
  -o ServerAliveCountMax=2 \
  "opc@$host" \
  'sudo -n /usr/bin/systemctl restart ashat-neural-host.service'
